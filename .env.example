# VideoMaker - Project Environment Variables
# Copy this file to .env and fill in your actual values
#
# Repository: https://github.com/ukoquique-proves/VIDEO_MAKER
GITHUB_TOKEN=your_github_token_here

# AI Providers (for pipeline script generation)
# Get your API keys from respective platforms
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here

# Voice Generation (TTS)
# Priority: Google Cloud TTS > Azure > Amazon Polly > ElevenLabs
#
# Google Cloud TTS (recommended - free tier: 4M chars/month)
# Get API key from https://console.cloud.google.com/apis/credentials
GOOGLE_CLOUD_API_KEY=your_google_cloud_key_here
# Optional: Language code and voice name (defaults to en-US-Standard-C)
# GOOGLE_CLOUD_LANGUAGE_CODE=en-US
# GOOGLE_CLOUD_VOICE_NAME=en-US-Standard-C
# GOOGLE_CLOUD_SPEAKING_RATE=1.0
# GOOGLE_CLOUD_PITCH=0.0

# Azure Cognitive Services Speech (free tier: 500K chars/month)
# Create resource at https://portal.azure.com/ → Speech Services
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here  # e.g., westus, eastus
# Optional: Voice and language settings
# AZURE_SPEECH_VOICE_NAME=en-US-JennyNeural
# AZURE_SPEECH_LANGUAGE=en-US
# AZURE_SPEECH_RATE=0%  # "-50%" to "+100%"

# Amazon Polly (free tier: 5M chars/month for 12 months)
# Create AWS account and IAM user with Polly permissions
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
# Optional: Voice settings
# AWS_POLLY_VOICE_ID=Joanna
# AWS_POLLY_ENGINE=neural  # "neural" or "standard"
# AWS_POLLY_LANGUAGE_CODE=en-US

# ElevenLabs (free tier: 10K chars/month, limited voices)
# Get API key from https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_key_here
# Optional: Custom voice ID (defaults to Rachel: 21m00Tcm4TlvDq8ikWAM)
# ELEVENLABS_VOICE_ID=your_voice_id_here
