{
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "ES2020"
        ],
        "module": "CommonJS",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "outDir": "../dist/pipeline",
        "skipLibCheck": true
    },
    "include": [
        "./**/*"
    ],
    "exclude": [
        "../node_modules"
    ]
}